{
  "app": "MusicApp",
  "num_prototypes": 5,
  "prototypes": [
    {
      "name": "PlayMusic",
      "intent": "Play a selected track and manage playback",
      "core_capabilities": [
        "BrowseMusic",
        "SelectTrack",
        "InitiatePlayback",
        "ControlPlayback"
      ],
      "steps": [
        {
          "step": "LocatePlayableTrack",
          "description": "Ensure a music track is selected and ready for playback",
          "required_capabilities": [
            "BrowseMusic",
            "SelectTrack"
          ],
          "optional_capabilities": [],
          "supporting_tig_nodes": [
            "TIG_LIBRARY_BROWSE",
            "TIG_MUSIC_ALBUM_EXPLORATION"
          ],
          "preconditions": ["library_accessible"],
          "postconditions": ["track_selected"],
          "exploration_strategy": "scroll_and_select"
        },
        {
          "step": "StartPlayback",
          "description": "Trigger playback of the selected track",
          "required_capabilities": [
            "InitiatePlayback"
          ],
          "optional_capabilities": [],
          "supporting_tig_nodes": [
            "TIG_PLAYBACK_CONTROL"
          ],
          "preconditions": ["track_selected"],
          "postconditions": ["playback_started"],
          "exploration_strategy": "retry_if_fail"
        },
        {
          "step": "PlaybackInteraction",
          "description": "Interact with playback (pause, seek, skip) after music starts",
          "required_capabilities": [],
          "optional_capabilities": [
            "PauseSong",
            "SeekTrack",
            "PlayNextTrack"
          ],
          "supporting_tig_nodes": [
            "TIG_PLAYBACK_CONTROL"
          ],
          "preconditions": ["playback_started"],
          "postconditions": ["playback_interacted"],
          "exploration_strategy": "retry_or_backtrack"
        }
      ],
      "preconditions": [
        "playable_content_available"
      ],
      "postconditions": [
        "music_is_playing_or_controlled"
      ]
    },
