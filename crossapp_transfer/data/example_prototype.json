{
  "app": "MusicApp",
  "num_prototypes": 5,
  "prototypes": [
    {
      "name": "PlayMusic",
      "intent": "Play a selected track and manage playback",
      "core_capabilities": [
        "Browse_Music",
        "Select_Track",
        "Initiate_Playback",
        "Control_Playback"
      ],
      "steps": [
        {
          "step": "Locate_Playable_Track",
          "description": "Identify a playable music track from library, album, or other collections",
          "required_capabilities": [
            "Browse_Music",
            "Select_Track"
          ],
          "supporting_tig_nodes": [
            "TIG_LIBRARY_BROWSE",
            "TIG_MUSIC_ALBUM_EXPLORATION"
          ]
        },
        {
          "step": "Start_Playback",
          "description": "Trigger playback of the selected track",
          "required_capabilities": [
            "Initiate_Playback"
          ],
          "supporting_tig_nodes": [
            "TIG_PLAYBACK_CONTROL"
          ]
        },
        {
          "step": "Playback_Interaction",
          "description": "Interact with playback after music starts",
          "optional_capabilities": [
            "Pause_Song",
            "Seek_Track",
            "Play_Next_Track"
          ],
          "supporting_tig_nodes": [
            "TIG_PLAYBACK_CONTROL"
          ]
        }
      ],
      "preconditions": [
        "playable_content_available"
      ],
      "postconditions": [
        "music_is_playing_or_controlled"
      ]
    },
    {
      "name": "SearchAndBrowseMusic",
      "intent": "Search for music content and browse results",
      "core_capabilities": [
        "Enter_Search_Mode",
        "Search_Music",
        "Browse_Results",
        "Select_Track"
      ],
      "steps": [
        {
          "step": "Enter_Search_Context",
          "description": "Switch the application into a searchable state",
          "required_capabilities": [
            "Enter_Search_Mode"
          ],
          "supporting_tig_nodes": [
            "TIG_SEARCH_MODE"
          ]
        },
        {
          "step": "Submit_Search_Query",
          "description": "Provide search input to retrieve music-related results",
          "required_capabilities": [
            "Search_Music"
          ],
          "supporting_tig_nodes": [
            "TIG_SEARCH_MODE"
          ]
        },
        {
          "step": "Explore_Search_Results",
          "description": "Browse, filter, or refine search results",
          "required_capabilities": [
            "Browse_Results"
          ],
          "optional_capabilities": [
            "Filter_Content"
          ],
          "supporting_tig_nodes": [
            "TIG_SEARCH_RESULTS",
            "TIG_MUSIC_ALBUM_EXPLORATION"
          ]
        },
        {
          "step": "Select_Result_Item",
          "description": "Select a track or album from search results",
          "required_capabilities": [
            "Select_Track"
          ],
          "supporting_tig_nodes": [
            "TIG_SEARCH_RESULTS"
          ]
        }
      ],
      "preconditions": [
        "search_functionality_available"
      ],
      "postconditions": [
        "search_target_identified"
      ]
    },
    {
      "name": "PlaylistManagement",
      "intent": "Create and manage playlists and playback queue",
      "core_capabilities": [
        "View_Playlists",
        "Create_Playlist",
        "Modify_Playlist",
        "Manage_Queue"
      ],
      "steps": [
        {
          "step": "Access_Playlist_Context",
          "description": "View existing playlists or playlist management area",
          "required_capabilities": [
            "View_Playlists"
          ],
          "supporting_tig_nodes": [
            "TIG_PLAYLIST_MANAGEMENT"
          ]
        },
        {
          "step": "Create_or_Update_Playlist",
          "description": "Create a new playlist or modify an existing one",
          "optional_capabilities": [
            "Create_Playlist",
            "Modify_Playlist"
          ],
          "supporting_tig_nodes": [
            "TIG_PLAYLIST_CREATION",
            "TIG_PLAYLIST_MANAGEMENT"
          ]
        },
        {
          "step": "Organize_Playlist_Content",
          "description": "Add, remove, or reorder tracks within a playlist",
          "optional_capabilities": [
            "Add_Track_To_Playlist",
            "Remove_Tracks",
            "Reorder_Tracks"
          ],
          "supporting_tig_nodes": [
            "TIG_PLAYLIST_MANAGEMENT"
          ]
        },
        {
          "step": "Manage_Playback_Queue",
          "description": "View or reorder the current playback queue",
          "optional_capabilities": [
            "Manage_Queue",
            "Reorder_Queue"
          ],
          "supporting_tig_nodes": [
            "TIG_QUEUE_MANAGEMENT"
          ]
        }
      ],
      "preconditions": [
        "playlist_features_available"
      ],
      "postconditions": [
        "playlist_or_queue_updated"
      ]
    },
